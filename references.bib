	author = {Feldman, Ted and Kar, Saibal and Elmariah, Sammy and Smart, Steven C. and Trento, Alfredo and Siegel, Robert J. and Apruzzese, Patricia and Fail, Peter and Rinaldi, Michael J. and Smalling, Richard W. and Hermiller, James B. and Heimansohn, David and Gray, William A. and Grayburn, Paul A. and Mack, Michael J. and Lim, D. Scott and Ailawadi, Gorav and Herrmann, Howard C. and Acker, Michael A. and Silvestry, Frank E. and Foster, Elyse and Wang, Andrew and Glower, Donald D. and Mauri, Laura and {EVEREST II Investigators}},
