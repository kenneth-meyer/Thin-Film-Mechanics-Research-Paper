@book{logg_automated_2012,
	address = {Berlin/Heidelberg, GERMANY},
	title = {Automated {Solution} of {Differential} {Equations} by the {Finite} {Element} {Method}: {The} {FEniCS} {Book}},
	isbn = {978-3-642-23099-8},
