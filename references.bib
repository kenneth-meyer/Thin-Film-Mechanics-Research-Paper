@article{su_endovascular_2021,
	title = {Endovascular {Release} of a 50-{Year}-{Old} {Adams}-{Deweese} {IVC} {Clip} to {Facilitate} {Percutaneous} {Repair} of {Mitral} {Valve} {Regurgitation}},
