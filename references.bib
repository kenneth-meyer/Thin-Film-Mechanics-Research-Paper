	pmid = {16980116},
	keywords = {Adolescent, Adult, Aged, Cost of Illness, Echocardiography, Female, Heart Valve Diseases, Humans, Male, Middle Aged, Population Surveillance, Prevalence, Survival Analysis, United States},
	pages = {1005--1011},
}

